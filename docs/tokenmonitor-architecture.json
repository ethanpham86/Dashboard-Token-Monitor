  "cards": [
    {
      "dot": "emerald",
      "title": "Nơi Cấu Hình & Thu Thập Thụ Động",
      "items": [
        "File config.yaml điều phối cổng 9090, đường dẫn SQLite và tần suất quét",
        "Trình collector/tailer.go đọc delta file transcript.jsonl theo offset (10s/lần)",
        "Trình storage/detector.go nhận diện phiên Google Ultra/Pro an toàn từ state.vscdb (mode=ro, zero mật khẩu)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Bộ Đệm Async & CSDL Quan Hệ ERD",
      "items": [
        "Hàng đợi collector/buffer.go đệm 1,000 sự kiện, tự động xả batch 100 bản ghi/1s",
        "Cấu trúc ERD 4 bảng: accounts (cha), auth_sessions, token_usage_logs và hourly_rollup",
        "SQLite WAL Mode đọc ghi song song, triệt tiêu hoàn toàn nguy cơ khóa CSDL"
      ]
    },
    {
      "dot": "rose",
      "title": "REST API & Dashboard Trực Quan",
      "items": [
        "web/handler.go cung cấp các REST API endpoints phản hồi dưới 10ms từ dữ liệu rollup",
        "Giao diện web/static/index.html hiển thị biểu đồ Donut mở rộng và phân tích đa model",
        "Tích hợp đếm ngược chu kỳ gói Ultra và tỷ lệ sử dụng Context Cache thời gian thực"
      ]
    },
    {
      "dot": "violet",
      "title": "Động Cơ FinOps & Quy Đổi USD/VNĐ",
      "items": [
        "storage/repository.go tính toán chi phí theo bảng giá chính thức Google Cloud Vertex AI & Gemini (Ultra/Pro/Flash)",
        "Context Caching tự động giảm 75% chi phí Prompt, đo lường chính xác số tiền tiết kiệm và tổng giá trị gộp",
        "Web Dashboard tích hợp Thẻ KPI thứ 6 (#card-finops-usd), cột Est. USD trong bảng lịch sử và Bộ máy tính FinOps quy đổi sang VNĐ"
      ]
    }
  ]
